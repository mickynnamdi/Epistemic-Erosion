# Copy this file to .env at the repository root and fill in what you need.
# .env is git-ignored. Every variable is optional: defaults live in configs/paths.py.

# --- Restricted data: PhysioNet credentialed access (never commit or share these files) ---
# Folder containing mimiciv/3.1/{hosp,icu} and mimic-iv-note/2.2/note (PhysioNet wget layout)
EE_MIMIC_ROOT=/path/to/physionet.org/files
# Folder containing RadGraph 1.0.0 (train.json, dev.json, test.json)
EE_RADGRAPH_ROOT=/path/to/physionet.org/files/radgraph/1.0.0

# --- Local folders (defaults: data/, data/external/, outputs/, results/ inside the repository) ---
# EE_ROOT=/path/to/repository
# EE_DATA_DIR=/path/to/data
# EE_EXTERNAL_DIR=/path/to/data/external
# EE_OUTPUTS_DIR=/path/to/outputs
# EE_RESULTS_DIR=/path/to/results
# EE_BIOSCOPE_DIR=/path/to/bioscope
# EE_NUBES_DIR=/path/to/nubes

# --- Model weights (optional: otherwise downloaded from the Hugging Face Hub at the pinned revision) ---
# EE_MODELS_ROOT=/path/to/local/checkpoints
# EE_MODEL_OVERRIDE=/path/to/one/checkpoint   # forces this checkpoint for src/generator.py
# HF_TOKEN=            # needed for the gated Llama and Gemma 3 repositories

# --- Paid APIs: only for scripts/hosted, scripts/judges, scripts/decision and scripts/validation/multi_annotator.py ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
